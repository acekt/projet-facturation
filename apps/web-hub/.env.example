# =============================================================================
# FACTURIER HUB SUPER ADMIN — VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# =============================================================================
# Copiez ce fichier vers `.env.local` pour le développement local ou
# configurez ces variables dans la console Vercel / Railway pour la production.
#
# IMPORTANT : Le domaine de production doit impérativement être servi en HTTPS
# pour permettre le fonctionnement des flux MFA TOTP et WebAuthn (Passkeys).
# =============================================================================

# URL de l'instance Supabase Cloud de production
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique Supabase (utilisée côté client et SSR pour l'authentification)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé de service Supabase (accès administrateur restreint aux Server Actions critiques)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret cryptographique de chiffrement des cookies de session d'administration (min 32 caractères)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=remplacez_par_un_secret_cryptographiquement_robuste_96_hex

# URL de réplication PowerSync Cloud (utilisée pour monitorer le connecteur de réplication)
POWERSYNC_URL=https://votre-instance.powersync.service
