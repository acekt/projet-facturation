# =============================================================================
# L'ÉTOILE — TEMPLATE DE VARIABLES D'ENVIRONNEMENT
# =============================================================================
# Copiez ce fichier vers `.env.local` et renseignez VOS propres valeurs.
#   cp .env.example .env.local
#
# NE COMMITEZ JAMAIS votre .env.local dans Git.
#
# Pour générer un secret fort (96 caractères hex = 384 bits d'entropie):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# Secret de signature HMAC-SHA256 des cookies de session.
# REQUIS — Minimum 32 caractères. L'application refuse de démarrer si absent.
SESSION_SECRET=REMPLACEZ_PAR_UN_SECRET_CRYPTOGRAPHIQUEMENT_FORT_96_CHARS_HEX

# Sel pour le hachage SHA-256 legacy des mots de passe (compatibilité ascendante).
# REQUIS — Minimum 16 caractères. L'application refuse de démarrer si absent.
PASSWORD_SALT=REMPLACEZ_PAR_UN_SEL_FORT_MIN_16_CHARS
