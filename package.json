{
  "name": "letoile-invoicing",
  "version": "1.0.0",
  "description": "L'Étoile — Logiciel de Gestion et Facturation Desktop",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:electron": "set NEXT_TELEMETRY_DISABLED=1 && next build",
    "start": "next start",
    "start:electron": "node .next/standalone/server.js",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:prod": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:win": "npm run build:electron && electron-builder --win",
    "pack": "electron-builder",
    "build:app": "next build && electron-builder",
    "test": "vitest run",
    "seed": "npx ts-node --project tsconfig.json seed.ts",
    "reset-db": "npx ts-node --project tsconfig.json reset-db.ts"
  },
  "build": {
    "appId": "com.letoile.invoicing",
    "productName": "L'Étoile",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.564.0",
    "next": "15.1.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "9.13.2",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.8"
  }
}
