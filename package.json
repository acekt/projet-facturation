{
  "name": "facturier-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=facturier-desktop",
    "dev:desktop": "npm run dev --workspace=facturier-desktop",
    "dev:web": "npm run dev --workspace=web-hub",
    "electron": "npm run electron --workspace=facturier-desktop",
    "build:desktop": "npm run build --workspace=facturier-desktop",
    "dist:win": "npm run dist:win --workspace=facturier-desktop",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "quality:decisions": "node scripts/check-decision-records.js"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  },
  "packageManager": "npm@11.15.0",
  "dependencies": {
    "@next/env": "^16.4.0",
    "next": "^16.4.0"
  }
}
